// OpenTopoMap Hike - Genshtab-style hiking cartography for MapLibre GL.
//
// Port of the Garmin style garmin/style/opentopomap-hike + its TYP palette
// garmin/style/typ/opentopomap-hike.txt. Icons and area hatchings are not
// redrawn here: vector/tools/typ_to_sprite.py extracts them from that same TYP
// file into otm_sprite, so the handheld map and the web map cannot drift.
//
// Palette (TYP type in brackets):
//   paper       #F3E6C4 [0x4b]   built-up  #E8B09A [0x10]   building #2A2A2A [0x13]
//   forest      #A8C888 / trees #3D6B2E [0x38 0x39 0x50]
//   meadow      #DCECB8 / #8CB868 [0x17]   scrub #BCD4A0 / #5A8A42 [0x4f]
//   farmland    #F3E6C4 / #C4A870 [0x1c]   sand  #F3E6C4 / #D4C060 [0x55]
//   rock/scree/moraine #5A3318 [0x56 0x57 0x54 0x36]
//   water       #9DD4E8 [0x32 0x3c] / lines and labels #2A6A9A [0x18 0x1f]
//   glacier     #FFFFFF [0x4d] / crevasse #2A6A9A [0x34 0x35]
//   roads       #C43C32 [0x01-0x03] / #E8B84A [0x04 0x08] / #F5E8C0 [0x05 0x06]
//   trails      track #6B4423 [0x07 0x0a] / footpath and steps #000000 [0x16 0x13]
//   contours    #C07848 / #A86038 / #8B4518 [0x20-0x22], on glaciers #2A6A9A [0x23-0x25]
//
// Data comes from tilemaker/process-otm.lua (source "opentopomap-vector"),
// which adds moraines, leaf_type, summit and pass elevations, rtsa_scale and the
// hiking POI set. Contours come from the client-side DEM isolines by default; a
// server-side contour tileset with on_glacier/steep attributes is picked up
// automatically because the colour expressions test for those attributes.

const otm_layers = [
{
	"id": "background",
	"type": "background",
	"paint": {"background-color": "#F3E6C4"}
},
{
	"id": "ocean",
	"source": "opentopomap-vector",
	"source-layer": "ocean",
	"type": "fill",
	"paint": {"fill-color": "#9DD4E8"}
},

// Landcover
// =========
{
	"id": "built-up-area",
	"source": "opentopomap-vector",
	"source-layer": "land",
	"filter": ["in", "type", "residential", "industrial", "commercial", "retail", "railway",
		"landfill", "brownfield", "greenfield", "farmyard", "garages", "construction"],
	"type": "fill",
	"paint": {"fill-color": "#E8B09A"}
},
{
	"id": "sites",
	"source": "opentopomap-vector",
	"source-layer": "sites",
	"minzoom": 12,
	"filter": ["in", "type", "university", "college", "school", "hospital", "prison"],
	"type": "fill",
	"paint": {"fill-color": "#E8B09A"}
},
{
	"id": "forest",
	"source": "opentopomap-vector",
	"source-layer": "land",
	"filter": ["in", "type", "forest", "forest_conifer", "forest_deciduous", "wood"],
	"type": "fill",
	"paint": {
		"fill-pattern": ["match", ["get", "type"],
			"forest_conifer", "pattern-forest-conifer",
			"forest_deciduous", "pattern-forest-deciduous",
			"pattern-forest"
		],
		"fill-outline-color": "#3D6B2E"
	}
},
{
	"id": "meadow",
