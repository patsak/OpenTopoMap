{
	"id": "power-lines",
	"source": "opentopomap-vector",
	"source-layer": "power_lines",
	"minzoom": 13,
	"type": "line",
	"paint": {"line-color": "#000000", "line-width": 0.4}
},
{
	"id": "boundaries",
	"source": "opentopomap-vector",
	"source-layer": "boundaries",
	"filter": ["<=", "admin_level", 4],
	"type": "line",
	"paint": {
		"line-color": "rgba(90,51,24,0.55)",
		"line-width": ["interpolate", ["linear"], ["zoom"],
			4, ["match", ["get", "admin_level"], 2, 1.2, 0.6],
			10, ["match", ["get", "admin_level"], 2, 2.4, 1.2]
		],
		"line-dasharray": [6, 2, 1, 2]
	}
},

// Symbols and labels
// ==================
{
	"id": "poi-symbols",
	"source": "opentopomap-vector",
	"source-layer": "pois",
	"minzoom": 12,
	"type": "symbol",
	"layout": {
		"symbol-placement": "point",
		"icon-image": ["coalesce", ["image", ["get", "type"]], ["image", "information"]],
		"icon-anchor": ["match", ["get", "type"], "peak", "bottom", "center"],
		// Sprite images already carry their intended screen size (roughly 1.5x the
		// Garmin bitmap, enough to stay legible); the single-tree landmarks are large
		// to begin with and would dominate.
		"icon-size": ["match", ["get", "type"], ["tree_needleleaved", "tree_broadleaved"], 0.6, 1],
		"icon-allow-overlap": true,
		"icon-keep-upright": true
	}
},
{
	"id": "peak-labels",
	"source": "opentopomap-vector",
	"source-layer": "pois",
	"minzoom": 12,
	"filter": ["in", "type", "peak", "volcano"],
	"metadata": {"translate": true},
	"type": "symbol",
	"layout": {
		// ele arrives as a double, so it has to be rounded: printing it raw gives
		// "3314.300048828125" instead of the metre value.
		"text-field": ["concat",
			["get", "name"],
			["case", ["has", "ele"], ["concat", "\n", ["to-string", ["round", ["get", "ele"]]]], ""]
		],
		"text-font": ["Roboto Regular"],
		"text-size": ["interpolate", ["linear"], ["zoom"], 12, 9, 16, 12],
		"text-anchor": "left",
		"text-offset": [0.7, -0.4],
		"text-optional": true
	},
	"paint": {
		"text-color": "#2A2A2A",
		"text-halo-color": "rgba(243,230,196,0.85)",
		"text-halo-width": 1.5
	}
},
{
	"id": "saddle-labels",
	"source": "opentopomap-vector",
	"source-layer": "pois",
	"minzoom": 12,
	"filter": ["==", "type", "saddle"],
	"metadata": {"translate": true},
	"type": "symbol",
	"layout": {
		"text-field": ["concat",
			["get", "name"],
			["case", ["has", "rtsa_scale"], ["concat", " ", ["get", "rtsa_scale"]], ""],
			["case", ["has", "ele"], ["concat", "\n", ["to-string", ["round", ["get", "ele"]]]], ""]
		],
		"text-font": ["Roboto Regular"],
		"text-size": ["interpolate", ["linear"], ["zoom"], 12, 9, 16, 12],
		"text-anchor": "left",
		"text-offset": [0.7, 0],
		"text-optional": true
	},
	"paint": {
		"text-color": "#2A2A2A",
		"text-halo-color": "rgba(243,230,196,0.85)",
		"text-halo-width": 1.5
	}
},
{
	"id": "poi-labels",
	"source": "opentopomap-vector",
	"source-layer": "pois",
	"minzoom": 14,
	"filter": ["!", ["in", ["get", "type"], ["literal", ["peak", "volcano", "saddle"]]]],
	"metadata": {"translate": true},
	"type": "symbol",
	"layout": {
		"symbol-placement": "point",
		"text-field": "{name}",
		"text-font": ["Roboto Regular"],
		"text-size": ["interpolate", ["linear"], ["zoom"], 14, 9, 17, 11],
		"text-anchor": "top",
		"text-offset": [0, 0.6],
		"text-optional": true
	},
	"paint": {
		"text-color": "#2A2A2A",
		"text-halo-color": "rgba(243,230,196,0.85)",
		"text-halo-width": 1.5
	}
},
{
