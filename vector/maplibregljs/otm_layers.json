			17, ["match", ["get", "type"], "motorway", 13, ["motorway_link", "trunk_link", "primary_link"], 8,
				"trunk", 12, "primary", 11, ["secondary", "secondary_link"], 10, ["tertiary", "tertiary_link"], 9,
				"unclassified", 8, ["residential", "living_street", "pedestrian"], 7, "service", 5, 5]
		],
		"line-opacity": ["case", ["to-boolean", ["coalesce", ["get", "tunnel"], false]], 0.4, 1]
