	"source-layer": "land",
	"minzoom": 10,
	"filter": ["in", "type", "meadow", "grass", "grassland", "village_green", "recreation_ground"],
	"type": "fill",
	"paint": {"fill-pattern": "pattern-meadow"}
},
{
	"id": "farmland",
	"source": "opentopomap-vector",
	"source-layer": "land",
	"minzoom": 10,
	"filter": ["==", "type", "farmland"],
	"type": "fill",
	"paint": {"fill-pattern": "pattern-farmland"}
