{
	"id": "place-small",
	"source": "opentopomap-vector",
	"source-layer": "place_labels",
	"minzoom": 12,
	"metadata": {"translate": true},
	"filter": ["in", "type", "suburb", "quarter", "neighbourhood", "island", "hamlet",
		"isolated_dwelling", "farm", "locality"],
	"type": "symbol",
	"layout": {
		"text-field": "{name}",
		"text-font": ["Roboto Regular"],
		"text-size": ["interpolate", ["linear"], ["zoom"], 12, 9, 15, 11],
		"text-variable-anchor": ["bottom-left", "center", "right", "bottom", "bottom-right", "top-left", "top", "top-right"]
	},
	"paint": {
		"text-color": "#2A2A2A",
		"text-halo-color": "rgba(243,230,196,0.9)",
		"text-halo-width": 1.5
	}
},
{
	"id": "place-village",
	"source": "opentopomap-vector",
	"source-layer": "place_labels",
	"metadata": {"translate": true},
	"filter": ["==", "type", "village"],
	"type": "symbol",
	"layout": {
		"text-field": "{name}",
		"text-font": ["Roboto Regular"],
		"text-size": ["interpolate", ["linear"], ["zoom"], 9, 10, 13, 13],
		"text-variable-anchor": ["bottom-left", "center", "right", "bottom", "bottom-right", "top-left", "top", "top-right"]
	},
	"paint": {
		"text-color": "#2A2A2A",
		"text-halo-color": "rgba(243,230,196,0.9)",
		"text-halo-width": 1.5
	}
},
{
	"id": "place-town",
	"source": "opentopomap-vector",
	"source-layer": "place_labels",
	"metadata": {"translate": true},
	"filter": ["in", "type", "town", "city", "state_capital", "capital"],
	"type": "symbol",
	"layout": {
		"text-field": "{name}",
		"symbol-sort-key": ["-", ["to-number", ["get", "population"], 0]],
		"text-font": ["Roboto Regular"],
		"text-size": ["interpolate", ["linear"], ["zoom"],
			6, ["match", ["get", "type"], "town", 10, 12],
			10, ["match", ["get", "type"], "town", 14, 19]
		],
		"text-transform": ["match", ["get", "type"], "capital", "uppercase", "none"],
		"text-max-width": 7,
		"text-variable-anchor": ["bottom-left", "center", "right", "bottom", "bottom-right", "top-left", "top", "top-right"]
	},
	"paint": {
		"text-color": "#2A2A2A",
		"text-halo-color": "rgba(243,230,196,0.9)",
		"text-halo-width": 2
	}
}
];
