	"type": "fill",
	"paint": {
		"fill-pattern": ["match", ["get", "type"], "vineyard", "pattern-vineyard", "pattern-orchard"]
	}
},
{
	"id": "scrub",
	"source": "opentopomap-vector",
	"source-layer": "land",
	"minzoom": 11,
