	"minzoom": 10,
	"filter": ["in", "type", "sand", "beach", "shingle"],
	"type": "fill",
	"paint": {"fill-pattern": "pattern-sand"}
},
{
	"id": "quarry",
	"source": "opentopomap-vector",
	"source-layer": "land",
	"minzoom": 11,
	"filter": ["==", "type", "quarry"],
