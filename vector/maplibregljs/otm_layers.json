	"id": "bare-rock",
	"source": "opentopomap-vector",
	"source-layer": "land",
	"minzoom": 12,
	"filter": ["==", "type", "bare_rock"],
	"type": "fill",
	"paint": {"fill-pattern": "pattern-bare-rock", "fill-opacity": 0.55}
},
{
	"id": "wetland",
	"source": "opentopomap-vector",
	"source-layer": "land",
	"minzoom": 11,
	"filter": ["in", "type", "swamp", "bog", "string_bog", "wet_meadow", "marsh"],
	"type": "fill",
	"paint": {"fill-pattern": "pattern-wetland"}
},
{
	"id": "cemetery",
	"source": "opentopomap-vector",
	"source-layer": "land",
	"minzoom": 13,
	"filter": ["in", "type", "grave_yard", "cemetery"],
