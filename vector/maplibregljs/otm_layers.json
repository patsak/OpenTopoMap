// Roads and trails
// ================
// Genshtab colours with a black casing on every driveable road; trails and
// tracks are dashes without casing, exactly like the Garmin line types.
{
	"id": "railway",
	"source": "opentopomap-vector",
	"source-layer": "streets",
	"filter": ["any", ["==", "type", "rail"], ["==", "type", "narrow_gauge"]],
	"type": "line",
	"paint": {
		"line-color": "#000000",
		"line-width": ["interpolate", ["linear"], ["zoom"], 8, 0.8, 12, 1.2, 17, 2.5],
		"line-opacity": ["case", ["to-boolean", ["coalesce", ["get", "tunnel"], false]], 0.4, 1]
	}
},
{
	"id": "roads-casing",
	"source": "opentopomap-vector",
	"source-layer": "streets",
	"filter": ["in", "type", "motorway", "motorway_link", "trunk", "trunk_link", "primary",
		"primary_link", "secondary", "secondary_link", "tertiary", "tertiary_link",
		"unclassified", "residential", "living_street", "pedestrian", "service", "busway"],
	"type": "line",
	"paint": {
		"line-color": "#000000",
		"line-width": ["interpolate", ["linear"], ["zoom"],
			8, ["match", ["get", "type"], "motorway", 3.2, "trunk", 3.0, "primary", 2.6, "secondary", 1.8, 0],
			10, ["match", ["get", "type"], "motorway", 4.4, ["motorway_link", "trunk_link", "primary_link"], 3.0,
				"trunk", 4.2, "primary", 3.6, ["secondary", "secondary_link"], 2.8, ["tertiary", "tertiary_link"], 2.4, 0],
			12, ["match", ["get", "type"], "motorway", 6.0, ["motorway_link", "trunk_link", "primary_link"], 3.6,
				"trunk", 5.6, "primary", 4.6, ["secondary", "secondary_link"], 4.0, ["tertiary", "tertiary_link"], 3.4,
				"unclassified", 2.8, ["residential", "living_street", "pedestrian"], 2.6, "service", 2.0, 2.0],
			14, ["match", ["get", "type"], "motorway", 7.5, ["motorway_link", "trunk_link", "primary_link"], 4.6,
				"trunk", 7.0, "primary", 6.0, ["secondary", "secondary_link"], 5.4, ["tertiary", "tertiary_link"], 4.6,
