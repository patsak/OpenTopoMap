// Water and ice
// =============
{
	"id": "water-poly",
	"source": "opentopomap-vector",
	"source-layer": "water_polygons",
	"filter": ["!=", "type", "glacier"],
	"type": "fill",
	"paint": {"fill-color": "#9DD4E8", "fill-outline-color": "#2A6A9A"}
},
{
	"id": "glacier",
	"source": "opentopomap-vector",
	"source-layer": "water_polygons",
	"filter": ["==", "type", "glacier"],
	"type": "fill",
	"paint": {"fill-color": "#FFFFFF", "fill-outline-color": "#2A6A9A"}
},
{
	// No outline: a crevasse field has no edge on the ground, so it is shown by the
	// hatching of crevasse-lines and crevasse-stripes, as on the Garmin map.
	"id": "crevasse-poly",
	"source": "opentopomap-vector",
	"source-layer": "natural_polygons",
	"minzoom": 9,
	"filter": ["==", "type", "crevasse"],
	"type": "fill",
	"paint": {"fill-color": "#FFFFFF"}
},
{
	// Cover moraine on ice: the same brown-dot stipple as scree, drawn after the
	// white glacier fill so the dots sit on the ice as on a Genshtab sheet.
	// A dedicated layer is required because the land "scree" layer is below ice.
	"id": "moraine-poly",
	"source": "opentopomap-vector",
	"source-layer": "natural_polygons",
	"minzoom": 12,
	"filter": ["==", "type", "moraine"],
	"type": "fill",
	"paint": {"fill-pattern": "pattern-scree"}
},

// Relief: shading only, no hypsometric tinting - the paper stays the base tone
{
	"id": "hillshade",
	"type": "hillshade",
	"source": "dem",
	"layout": {"visibility": "visible"},
	"paint": {
		"hillshade-method": "igor",
		"hillshade-exaggeration": 0.3,
		"hillshade-shadow-color": "rgba(90,51,24,0.35)",
		"hillshade-highlight-color": "rgba(255,255,255,0.0)",
		"hillshade-accent-color": "rgba(90,51,24,0.15)"
	}
},

// Contours
// ========
// Three-step Genshtab hierarchy derived from the elevation: every 100 m thick,
// every 50 m medium, the rest thin. Blue on glaciers as soon as the contour
// source provides on_glacier; the client-side DEM isolines do not, so they stay
// brown there. "steep" thins the major lines on slopes over 50 degrees.
{
	"id": "contour-lines",
	"type": "line",
	"source": "contour-source",
	"source-layer": "contours",
	"paint": {
		"line-color": ["case",
			["to-boolean", ["coalesce", ["get", "on_glacier"], false]], "#2A6A9A",
			["==", ["%", ["get", "ele"], 100], 0], "#8B4518",
			["==", ["%", ["get", "ele"], 50], 0], "#A86038",
			"#C07848"
		],
		"line-width": ["interpolate", ["linear"], ["zoom"],
			11, ["case", ["==", ["%", ["get", "ele"], 100], 0], 0.6, 0.3],
			14, ["case",
				["all", ["==", ["%", ["get", "ele"], 100], 0], ["!", ["to-boolean", ["coalesce", ["get", "steep"], false]]]], 1.4,
				["==", ["%", ["get", "ele"], 50], 0], 0.8,
				0.5
			],
			17, ["case",
				["all", ["==", ["%", ["get", "ele"], 100], 0], ["!", ["to-boolean", ["coalesce", ["get", "steep"], false]]]], 2.2,
				["==", ["%", ["get", "ele"], 50], 0], 1.2,
				0.7
			]
		]
	}
},
{
	"id": "contour-labels",
	"type": "symbol",
	"source": "contour-source",
	"source-layer": "contours",
	"minzoom": 13,
	"filter": ["case", ["<=", ["zoom"], 14], ["==", ["%", ["get", "ele"], 100], 0], true],
	"layout": {
		"symbol-placement": "line",
		"symbol-spacing": 220,
		"text-max-angle": 120,
		"text-keep-upright": false,
		"text-field": "{ele}",
		"text-size": ["step", ["zoom"], 8, 15, 9],
		"text-font": ["Roboto Regular"]
	},
	"paint": {
		"text-color": ["case", ["to-boolean", ["coalesce", ["get", "on_glacier"], false]], "#2A6A9A", "#A86038"],
		"text-halo-color": "rgba(243,230,196,0.7)",
		"text-halo-width": 1.5
	}
},

