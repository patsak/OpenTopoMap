# Build context: repository root (OpenTopoMap/)
# See www/docker-compose.yml

www/mapsvc/data/
www/mapsvc/output/
www/mapsvc/.venv/
www/mapsvc/.venv-*/
**/__pycache__/
**/*.pyc
**/.DS_Store
**/*.img
**/*.gmap/
**/*.osm.pbf
**/*.zip
**/*.hgt
# The Java tooling is installed by mapsvc/artifacts.py into OTM_TOOLS_DIR, and
# downloads land under data/, which is already excluded above. tools/ is only a
# leftover from when they were unpacked into the source tree; nothing in it must
# reach the image, least of all a jar without its lib/ directory, which runs
# until it needs fastutil and then dies mid-build.
www/mapsvc/tools/
.git/
**/.venv/
www/docker-compose.override.yml
garmin/data/
garmin/output/
garmin/screenshots/
